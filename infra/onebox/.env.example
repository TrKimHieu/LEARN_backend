# LEARN one-origin host. Copy to infra/onebox/.env and fill real values; never commit .env.
# Generate secrets: openssl rand -base64 48

# Tested image digests (from each repository's immutable-images workflow artifact).
API_IMAGE=ghcr.io/trkimhieu/learn_backend-api@sha256:replace-me
WORKER_IMAGE=ghcr.io/trkimhieu/learn_backend-worker@sha256:replace-me
# Must be built with an empty NEXT_PUBLIC_API_URL (relative /api paths).
WEB_IMAGE=ghcr.io/trkimhieu/learn_website-web@sha256:replace-me
# Migration image (API builder stage). On AWS, keep any placeholder here: the first release fills in all *_IMAGE values.
MIGRATE_IMAGE=learn-migrate:local

# Public origin. Without a domain use <IP-with-dashes>.sslip.io, e.g. 3.1.2.4 -> 3-1-2-4.sslip.io.
DOMAIN=3-1-2-4.sslip.io
APP_URL=https://3-1-2-4.sslip.io
# Presigned upload URLs are signed for the public origin; Caddy forwards /learn-documents/* to MinIO.
S3_PUBLIC_ENDPOINT=https://3-1-2-4.sslip.io
# Local trial on a Windows machine where 80/443 are taken:
# HTTP_PORT=8080
# HTTPS_PORT=8443

# Database (internal containers, no published ports).
POSTGRES_USER=learn
POSTGRES_PASSWORD=change-me-long-secret
POSTGRES_DB=learn
DATABASE_URL=postgresql://learn:change-me-long-secret@postgres:5432/learn?schema=public
REDIS_URL=redis://redis:6379

# Document storage (internal MinIO). The bucket name must stay learn-documents to match the Caddy route.
S3_ENDPOINT=http://minio:9000
S3_BUCKET=learn-documents
S3_ACCESS_KEY_ID=learn-minio
S3_SECRET_ACCESS_KEY=change-me-long-secret
S3_REGION=us-east-1

# Auth. The API refuses to start with development values.
JWT_ACCESS_SECRET=change-me-at-least-32-characters-long-secret
# Admin created by the first seed (at least 12 characters). Production seed creates no demo accounts.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-strong-admin-password

# AI. live calls a paid model for every generation request; keep the cost cap low.
LLM_MODE=mock
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL_GENERATION=gpt-6-luna
LLM_MODEL_FAST=gpt-6-luna
LLM_MODEL_FALLBACK=gpt-5-nano
LLM_REASONING_EFFORT=low
AI_JOB_MAX_COST_USD=0.05

# Email (password reset). log = link only in server logs; smtp = send through SMTP_URL.
MAIL_MODE=log
SMTP_URL=
MAIL_FROM=LEARN <no-reply@example.com>

BILLING_MODE=demo
APP_TIMEZONE=Asia/Ho_Chi_Minh
MIN_MOBILE_VERSION=1.0.0
